From 20a817ae6b7ef9557e1dc184108b5798246ef845 Mon Sep 17 00:00:00 2001
From: Gigi <42325924+g-cqd@users.noreply.github.com>
Date: Thu, 8 Oct 2026 03:12:01 +0200
Subject: [PATCH 12/12] ntdll/unix: no x87sidecar lookup on arm64 (new base
 decides it in NtCreateUserProcess before fork; ROSETTA_X87_PATH must not
 trigger it here)

---
 dlls/ntdll/unix/loader.c | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/dlls/ntdll/unix/loader.c b/dlls/ntdll/unix/loader.c
index fdbeae7..654a6bd 100644
--- a/dlls/ntdll/unix/loader.c
+++ b/dlls/ntdll/unix/loader.c
@@ -767,8 +767,12 @@ static WORD get_pe_file_machine( const char *path )
  */
 const char *get_x87_sidecar_path(void)
 {
-    const char *path = getenv( "ROSETTA_X87_PATH" );
+    const char *path;
 
+#ifdef __aarch64__
+    return NULL;  /* no x87sidecar on a native arm64 Wine: x86 code runs in the WoW64 CPU backend, not Rosetta */
+#endif
+    path = getenv( "ROSETTA_X87_PATH" );
     if (path) return *path ? path : NULL;
 #if defined(__APPLE__) && defined(__x86_64__)
     {
